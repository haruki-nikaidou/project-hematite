---
// Static redirect to /en/
// The Astro redirects config handles the actual redirect;
// this page acts as a no-JS fallback.
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0;url=/en/" />
    <link rel="canonical" href="/en/" />
    <title>Redirecting…</title>
    <script>location.replace('/en/');</script>
  </head>
  <body>
    <p>Redirecting to <a href="/en/">/en/</a>…</p>
  </body>
</html>
