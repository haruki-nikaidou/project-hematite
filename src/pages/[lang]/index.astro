---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Search from "../../components/Search.svelte";
import HematiteIcon from "../../components/HematiteIcon.astro";
import LevelBadge from "../../components/LevelBadge.astro";
import {
    LOCALES,
    LEVELS,
    CATEGORIES,
    LEVEL_LABELS,
    CATEGORY_LABELS,
} from "../../lib/constants";
import { indexUrl } from "../../lib/paths";
import type { Locale } from "../../lib/constants";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
    return LOCALES.map((lang) => ({ params: { lang } }));
};

const { lang } = Astro.params as { lang: Locale };

const levelDescriptions: Record<string, Record<string, string>> = {
    en: {
        elementry: "Foundational concepts every Rust developer should know.",
        basis: "Core computer science and mathematical foundations.",
        essential: "Topics essential for writing idiomatic Rust.",
        advanced: "Deep dives into complex systems and patterns.",
        "cutting-edge": "The latest research and emerging techniques.",
        tricks: "Practical tips and idioms for everyday coding.",
        proof: "Formal proofs and theoretical underpinnings.",
        homework: "Exercises and challenges to reinforce learning.",
        "side-lines": "Worth knowing but not critical.",
    },
    ja: {
        elementry: "すべてのRust開発者が知るべき基礎概念。",
        basis: "コンピュータサイエンスと数学の基礎。",
        essential: "慣用的なRustを書くための必須トピック。",
        advanced: "複雑なシステムとパターンの深掘り。",
        "cutting-edge": "最新の研究と新興技術。",
        tricks: "日常的なコーディングの実践的なヒントとイディオム。",
        proof: "形式的な証明と理論的な基盤。",
        homework: "学習を強化するための演習と課題。",
        "side-lines": "知っておくと良いが重要ではないもの。",
    },
    "zh-tw": {
        elementry: "每位 Rust 開發者都應掌握的基礎概念。",
        basis: "計算機科學與數學的核心基礎。",
        essential: "撰寫慣用 Rust 不可或缺的主題。",
        advanced: "深入探討複雜的系統與模式。",
        "cutting-edge": "最新的研究與新興技術。",
        tricks: "日常開發中實用的技巧與慣用寫法。",
        proof: "形式化證明與理論基礎。",
        homework: "用以鞏固學習的練習與挑戰。",
        "side-lines": "知道了不錯，但並非關鍵的內容。",
    },
};

const desc = levelDescriptions[lang] ?? levelDescriptions.en;

const howToUse: Record<
    Locale,
    { title: string; intro: string; steps: string[]; levelsLabel: string; categoriesLabel: string }
> = {
    en: {
        title: "How to use this site",
        intro:
            "Project Hematite organizes Rust learning as checkpoints in a prerequisite graph. Here is how to get started:",
        steps: [
            "Search for any concept in the bar above, or browse by Level or Category below.",
            "Open a checkpoint and read its prerequisites first — they point to what you should understand before this topic.",
            "Use the public graph at /latest.json to connect your own progress tracker or dashboard to the same DAG.",
            "Switch the display language on any checkpoint page via the language switcher when a translation is available.",
        ],
        levelsLabel: "Levels",
        categoriesLabel: "Categories",
    },
    ja: {
        title: "このサイトの使い方",
        intro:
            "Project Hematite は Rust の学習を、前提関係グラフ上のチェックポイントとして整理しています。次の手順で始めてください:",
        steps: [
            "上の検索バーで概念を探すか、下のレベル・カテゴリから一覧を開きます。",
            "チェックポイントを開き、前提知識を先に読みます — このトピックの前に理解すべき内容へのリンクです。",
            "公開グラフ /latest.json を使えば、同じ DAG に自分の進捗トラッカーやダッシュボードを接続できます。",
            "翻訳があるチェックポイントでは、ページ上の言語切替で表示言語を切り替えられます。",
        ],
        levelsLabel: "レベル",
        categoriesLabel: "カテゴリ",
    },
    "zh-tw": {
        title: "如何使用本站",
        intro:
            "Project Hematite 將 Rust 的學習內容組織成先備關係圖上的檢查點。以下是入門方式：",
        steps: [
            "在上方搜尋列輸入任何概念，或從下方依等級或分類瀏覽。",
            "開啟一個檢查點，先閱讀它的先備知識 —— 那是學習本主題前應先理解的內容。",
            "透過公開圖譜 /latest.json，可將你自己的進度追蹤器或儀表板連接到同一份 DAG。",
            "在有提供翻譯的檢查點頁面，可使用語言切換器切換顯示語言。",
        ],
        levelsLabel: "等級",
        categoriesLabel: "分類",
    },
};

const guide = howToUse[lang] ?? howToUse.en;

const taglines: Record<Locale, string> = {
    en: "Open education for future Rust developers",
    ja: "Rust開発者のためのオープン教育サイト",
    "zh-tw": "為未來 Rust 開發者打造的開放教育網站",
};
const tagline = taglines[lang] ?? taglines.en;
---

<BaseLayout title="Project Hematite" lang={lang}>
    <div class="home-wrap">
        <header class="home-hero" data-pagefind-ignore>
            <div class="hero-icon">
                <HematiteIcon size="5rem" />
            </div>
            <h1 class="home-title">
                Project <span class="accent">Hematite</span>
            </h1>
            <p class="home-tagline">{tagline}</p>
            <div class="home-search">
                <Search {lang} client:load />
            </div>
        </header>

        <section class="home-intro" data-pagefind-ignore>
            <h2 class="intro-title">{guide.title}</h2>
            <p class="intro-lead">{guide.intro}</p>
            <ol class="intro-steps">
                {guide.steps.map((step) => <li>{step}</li>)}
            </ol>
        </section>

        <section class="home-section">
            <h2 class="section-label">{guide.levelsLabel}</h2>
            <div class="card-grid">
                {
                    LEVELS.map((level) => (
                        <a href={indexUrl(lang, level)} class="card">
                            <div class="card-title">
                                <LevelBadge {level} {lang} />
                            </div>
                            <p class="card-desc">{desc[level]}</p>
                        </a>
                    ))
                }
            </div>
        </section>

        <section class="home-section">
            <h2 class="section-label">{guide.categoriesLabel}</h2>
            <div class="card-grid">
                {
                    CATEGORIES.map((cat) => (
                        <a href={indexUrl(lang, cat)} class="card">
                            <div class="card-title">
                                <LevelBadge level={cat} {lang} />
                            </div>
                            <p class="card-desc">{desc[cat]}</p>
                        </a>
                    ))
                }
            </div>
        </section>
    </div>
</BaseLayout>

<style lang="scss">
    @use "../../styles/layout";

    .home-wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 var(--space-6) var(--space-16);
    }

    .hero-icon {
        display: flex;
        justify-content: center;
    }

    .home-hero {
        text-align: center;
        padding: var(--space-16) 0 var(--space-12);
    }

    .home-title {
        font-size: clamp(2rem, 6vw, 3.5rem);
        margin: 0 0 var(--space-4);
        letter-spacing: -0.03em;
    }

    .accent {
        color: var(--active);
    }

    .home-tagline {
        font-size: 1.15rem;
        color: var(--muted);
        margin: 0 0 var(--space-8);
    }

    .home-search {
        max-width: 520px;
        margin: 0 auto;
    }

    .home-intro {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: var(--space-8);
        margin-bottom: var(--space-4);
    }

    .intro-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0 0 var(--space-4);
        letter-spacing: -0.01em;
        border: none;
        padding: 0;
    }

    .intro-lead {
        color: var(--muted);
        line-height: 1.6;
        margin: 0 0 var(--space-6);
    }

    .intro-steps {
        margin: 0;
        padding-left: 1.25rem;
        line-height: 1.65;

        li {
            margin-bottom: var(--space-3);

            &:last-child {
                margin-bottom: 0;
            }
        }
    }

    .home-section {
        margin-top: var(--space-12);
    }

    .section-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
        margin: 0 0 var(--space-6);
        border: none;
        padding: 0;
    }
</style>
